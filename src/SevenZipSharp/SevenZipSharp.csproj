<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <PackageId>SevenZipSharp</PackageId>
    <Version>2.0.0-alpha.1</Version>
    <Authors>SevenZipSharp contributors</Authors>
    <Description>A NativeAOT-first, source-generated COM wrapper for the 7-Zip archive engine.</Description>
    <PackageTags>7zip;archive;compression;nativeaot</PackageTags>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/0x5bfa/SevenZipSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="licenses/THIRD-PARTY-NOTICES.md" />
    <None Include="SOURCE-OFFER.md" Pack="true" PackagePath="licenses/SOURCE-OFFER.md" />
    <None Include="licenses\7-Zip-License.txt" Pack="true" PackagePath="licenses/7-Zip-License.txt" />
    <None Include="licenses\source\7z2602-src.tar.xz" Pack="true" PackagePath="licenses/source/7z2602-src.tar.xz" />
    <None Include="buildTransitive\SevenZipSharp.targets" Pack="true" PackagePath="buildTransitive/SevenZipSharp.targets" />
    <None Include="runtimes\win-x86\native\7z.dll" Pack="true" PackagePath="runtimes/win-x86/native/7z.dll" />
    <None Include="runtimes\win-x64\native\7z.dll" Pack="true" PackagePath="runtimes/win-x64/native/7z.dll" />
    <None Include="runtimes\win-arm64\native\7z.dll" Pack="true" PackagePath="runtimes/win-arm64/native/7z.dll" />
  </ItemGroup>
</Project>
